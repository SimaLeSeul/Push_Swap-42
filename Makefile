OBJ = $(SRC:.c=.o)

all: $(NAME)

$(NAME): $(OBJ) $(LIBFT)
	$(CC) $(CFLAGS) $(OBJ) $(LIBFT) -o $@

$(LIBFT): FORCE
	$(MAKE) -C $(LIBFT_DIR) CC="$(CC)" CFLAGS="$(CFLAGS)"

%.o: %.c push_swap.h $(LIBFT_DIR)/libft.h $(LIBFT_DIR)/ft_printf/ft_printf.h
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	$(RM) $(OBJ)
	$(MAKE) -C $(LIBFT_DIR) clean

fclean: clean
	$(RM) $(NAME)
	$(MAKE) -C $(LIBFT_DIR) fclean

re: fclean
	$(MAKE) all

FORCE:

.PHONY: all clean fclean re FORCE
